# Recommended: API key (https://imgflip.com/api -> API Settings)
IMGFLIP_API_KEY=

# Alternative: Imgflip account username + password
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=

# HTTP server only
# PORT=3000
# MCP_AUTH_TOKEN=   # if set, required as "Authorization: Bearer <token>" and enables env credentials over HTTP
# OAUTH_SECRET=  # >= 32 chars (openssl rand -hex 32); with PUBLIC_URL enables the OAuth login (claude.ai connectors)
# PUBLIC_URL=    # public origin, e.g. https://mememcp.example.com
# OAUTH_REDIRECT_HOSTS=  # comma-separated https hosts allowed as OAuth callbacks (default: claude.ai,claude.com; loopback always allowed)
