{
  "name": "imgflip-meme-mcp",
  "version": "0.1.0",
  "description": "MCP server per creare meme con l'API di Imgflip: trova il template giusto per una frase e genera il meme.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "imgflip-meme-mcp": "dist/stdio.js",
    "imgflip-meme-mcp-http": "dist/http.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
